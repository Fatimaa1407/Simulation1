@using Simulation1.Areas.Admin.ViewModels.Position
@model CreatePositionVM

<div>
    <h2>Create position</h2>
    <form asp-controller="Position" asp-action="Create" method="post">
        <div class="form-group">
            <label for="exampleInputEmail1">Position Name</label>
            <input asp-for="Name" type="text" class="form-control" id="exampleInputEmail1" placeholder="Enter name">
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
